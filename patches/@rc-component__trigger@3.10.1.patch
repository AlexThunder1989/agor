+// This callback may outlive its owner through a deleted host Fiber.ref.
+// Give it only an owner-cleared cell, never Trigger's render context or a
+// state dispatch (whose queue can retain lastRenderedState after unmount).
+function createTargetRef(cell, targetRef) {
+  return node => {
+    const nextTarget = getDOM(node);
+    if (targetRef.current !== nextTarget) {
+      targetRef.current = nextTarget;
+      cell.current.update?.(nextTarget);
+    }
+  };
+}
+function useTarget() {
+  const [targetEle, setTargetEle] = React.useState(null);
+  const cell = React.useRef({ update: setTargetEle });
+  const externalForwardRef = React.useRef(null);
+  const setTargetRef = React.useMemo(() => createTargetRef(cell, externalForwardRef), []);
+  useLayoutEffect(() => {
+    cell.current.update = setTargetEle;
+    setTargetEle(externalForwardRef.current);
+    return () => {
+      cell.current.update = null;
+      externalForwardRef.current = null;
+    };
+  }, []);
+  return [targetEle, externalForwardRef, setTargetRef];
+}
+
+// Use React's dependency comparison (the util hook misses single-ref changes)
+// and preserve cleanup-return refs without retaining Trigger's render context.
+const supportsRefCleanup = Number(React.version.split('.')[0]) >= 19;
+function assignChildRef(ref, node) {
+  if (typeof ref === 'function') return ref(node);
+  if (ref) ref.current = node;
+}
+function composeTargetRef(targetRef, childRef) {
+  if (!childRef) return targetRef;
+  return node => {
+    targetRef(node);
+    try {
+      const cleanup = assignChildRef(childRef, node);
+      if (node !== null && supportsRefCleanup) {
+        return () => {
+          targetRef(null);
+          if (typeof cleanup === 'function') cleanup();
+          else assignChildRef(childRef, null);
+        };
+      }
+    } catch (error) {
+      targetRef(null);
+      throw error;
+    }
+  };
+}
+function useTargetRef(targetRef, childRef) {
+  return React.useMemo(() => composeTargetRef(targetRef, childRef), [targetRef, childRef]);
+}
+export { useTargetRef };
+export default useTarget;
