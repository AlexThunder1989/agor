+// DOM ref callbacks may survive their owner through a deleted host Fiber.ref.
+// Retain only owner-cleared cells, never Trigger's render context or a direct
+// state dispatcher (whose queue retains lastRenderedState after unmount).
+function publish(cell, domRef) {
+  const current = cell.current;
+  if (current.update && current.value !== domRef.current) {
+    current.value = domRef.current;
+    current.update(domRef.current);
+  }
+}
+function createTargetRef(cell, domRef) {
+  return node => {
+    const next = getDOM(node);
+    domRef.current = next;
+    const current = cell.current;
+    const revision = ++current.revision;
+    if (current.update) current.register?.(current.id, next);
+    if (next !== null) {
+      publish(cell, domRef);
+    } else {
+      // Ref replacement detaches and attaches within one commit. Notify the
+      // child ref immediately, but do not publish a transient internal null.
+      // A real descendant-only removal still publishes null after this commit.
+      queueMicrotask(() => {
+        if (cell.current.revision === revision) publish(cell, domRef);
+      });
+    }
+  };
+}
+function useTarget(parentContext, id) {
+  const [targetEle, setTargetEle] = React.useState(null);
+  const cell = React.useRef({ update: setTargetEle, value: null, revision: 0,
+    register: parentContext?.registerSubPopup, id });
+  const externalForwardRef = React.useRef(null);
+  const setTargetRef = React.useMemo(() => createTargetRef(cell, externalForwardRef), []);
+  useLayoutEffect(() => {
+    const current = cell.current;
+    current.update = setTargetEle;
+    current.register = parentContext?.registerSubPopup;
+    current.id = id;
+    current.register?.(id, externalForwardRef.current);
+    publish(cell, externalForwardRef);
+    return () => {
+      try {
+        current.register?.(current.id, null);
+      } finally {
+        current.update = null;
+        current.register = null;
+        current.value = null;
+        ++current.revision;
+        externalForwardRef.current = null;
+      }
+    };
+  }, []);
+  // Publish only committed context replacements, never a suspended render's.
+  useLayoutEffect(() => {
+    const current = cell.current;
+    const register = parentContext?.registerSubPopup;
+    if (current.register !== register || current.id !== id) {
+      current.register?.(current.id, null);
+      current.register = register;
+      current.id = id;
+      register?.(id, externalForwardRef.current);
+    }
+    publish(cell, externalForwardRef);
+  });
+  return [targetEle, externalForwardRef, setTargetRef];
+}
